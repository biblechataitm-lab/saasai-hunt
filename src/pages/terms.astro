---
import Layout from '@/layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Terms of Service — SaaSHunt">
  <div class="container" style="max-width: 800px; padding-top: 3rem; padding-bottom: 5rem;">
    <h1 style="font-size: 2.5rem; margin-bottom: 1.5rem;">Terms of Service</h1>
    <div style="background-color: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-main); padding: 2.5rem;" class="prose-body">
      <h2>1. Directory Terms</h2>
      <p>By accessing SaaSHunt, you agree to comply with standard platform usage guidelines and respect intellectual property rights.</p>
    </div>
  </div>
</Layout>
