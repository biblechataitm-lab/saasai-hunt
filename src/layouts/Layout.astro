---
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import { getSiteConfig } from '@/lib/ads';
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const { title, description } = Astro.props;
const config = await getSiteConfig();
const siteName = config?.name || 'SaaSAI Hunt';
const pageTitle = title || `${siteName} — Curated Directory`;
const pageDescription = description || `The curated directory on ${siteName}`;
const pathname = Astro.url.pathname;
const isHome = Astro.props.isHome ?? (pathname === '/' || pathname === '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-wrapper">
      <Header client:load siteName={siteName} />
      <main class={`site-main ${!isHome ? "site-main-offset" : ""}`}>
        
        <slot />
      </main>
      <Footer client:idle siteName={siteName} />
    </div>
  </body>
</html>
